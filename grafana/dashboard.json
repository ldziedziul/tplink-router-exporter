{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Router Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "cellOptions": { "type": "auto" }, "inspect": false },
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "WAN IP" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "showHeader": false,
        "footer": { "show": false }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "tplink_router_info{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "WAN IP",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "connection_type": true,
              "lan_ip": true,
              "instance": true,
              "Value": true
            },
            "indexByName": { "node": 0, "wan_ip": 1 },
            "renameByName": { "node": "Node", "wan_ip": "WAN IP" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "cellOptions": { "type": "auto" }, "inspect": false },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "LAN IP" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "showHeader": false,
        "footer": { "show": false }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "tplink_router_info{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "LAN IP",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "connection_type": true,
              "wan_ip": true,
              "instance": true,
              "Value": true
            },
            "indexByName": { "node": 0, "lan_ip": 1 },
            "renameByName": { "node": "Node", "lan_ip": "LAN IP" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 3, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "tplink_cpu_usage_ratio{instance=~\"$instance\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 3, "x": 11, "y": 1 },
      "id": 4,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "tplink_memory_usage_ratio{instance=~\"$instance\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "mappings", "value": [{ "options": { "0": { "color": "red", "index": 1, "text": "Error" }, "1": { "color": "green", "index": 0, "text": "OK" } }, "type": "value" }] },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "custom.width", "value": 60 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last Scrape" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 80 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Node" },
            "properties": [
              { "id": "custom.width", "value": 100 }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": { "show": false }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "tplink_scrape_success{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "timestamp(tplink_scrape_success{instance=~\"$instance\"}) * 1000",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "tplink_scrape_duration_seconds{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "title": "Scrape Status",
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": { "byField": "instance" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "node 2": true,
              "node 3": true,
              "instance": true
            },
            "indexByName": {
              "node 1": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "node 1": "Node",
              "Value #A": "Status",
              "Value #B": "Last Scrape",
              "Value #C": "Duration"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 2, "x": 0, "y": 4 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "count(tplink_device_active{instance=~\"$instance\",ip!=\"0.0.0.0\"} == 1) by (instance, node)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Total Clients",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
