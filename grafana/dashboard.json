        },
        {
          "expr": "tplink_device_signal_dbm{instance=~\"$instance\",connection_type!=\"wired\",ip!=\"0.0.0.0\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "tplink_device_download_speed_bytes{instance=~\"$instance\",connection_type!=\"wired\",ip!=\"0.0.0.0\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "tplink_device_upload_speed_bytes{instance=~\"$instance\",connection_type!=\"wired\",ip!=\"0.0.0.0\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "title": "Connected Devices (WiFi)",
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": { "byField": "mac" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "connection_type 2": true,
              "connection_type 3": true,
              "connection_type 4": true,
              "hostname 2": true,
              "hostname 3": true,
              "hostname 4": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "ip 2": true,
              "ip 3": true,
              "ip 4": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "node 2": true,
              "node 3": true,
              "node 4": true
            },
            "indexByName": {
