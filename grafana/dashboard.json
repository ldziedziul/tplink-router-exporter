        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "tplink_clients_total{instance=~\"$instance\"}",
          "legendFormat": "Total {{node}}",
          "refId": "A"
        },
        {
          "expr": "tplink_wifi_clients_total{instance=~\"$instance\"}",
          "legendFormat": "WiFi {{node}}",
          "refId": "B"
        },
        {
          "expr": "tplink_wired_clients_total{instance=~\"$instance\"}",
          "legendFormat": "Wired {{node}}",
          "refId": "C"
        }
      ],
      "title": "Connected Clients",
      "type": "timeseries"
