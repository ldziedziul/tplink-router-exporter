      "targets": [
        {
          "expr": "count(tplink_device_active{instance=~\"$instance\",connection_type=\"wired\",ip!=\"0.0.0.0\"} == 1) by (instance, node)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Wired Clients",
